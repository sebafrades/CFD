    ($i_sqr $n_i_sqr $z_step)
    ($i_minor $i_minor $z_step) //18
    ($n_i_minor $i_minor $z_step)
    ($n_i_minor $n_i_minor $z_step)
    ($i_minor $n_i_minor $z_step)
    ($i_r $i_r $z_step) //22
    ($n_i_r $i_r $z_step)
    ($n_i_r $n_i_r $z_step)
    ($i_r $n_i_r $z_step)
    ($i_R $i_R $z_step) //26
    ($n_i_R $i_R $z_step)
    ($n_i_R $n_i_R $z_step)
    ($i_R $n_i_R $z_step)

    //Outlet
    (0 0 $z_end) //30
    ($i_sqr $i_sqr $z_end) //31
    ($n_i_sqr $i_sqr $z_end)
    ($n_i_sqr $n_i_sqr $z_end)
    ($i_sqr $n_i_sqr $z_end)
    ($i_minor $i_minor $z_end) //30
    ($n_i_minor $i_minor $z_end)
    ($n_i_minor $n_i_minor $z_end)
    ($i_minor $n_i_minor $z_end)
    ($i_r $i_r $z_end) //39
    ($n_i_r $i_r $z_end)
    ($n_i_r $n_i_r $z_end)
    ($i_r $n_i_r $z_end)
    ($i_R $i_R $z_end) //43
    ($n_i_R $i_R $z_end)
    ($n_i_R $n_i_R $z_end)
    ($i_R $n_i_R $z_end)
);

