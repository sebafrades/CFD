convertToMeters 0.01;

r 0.5;
R 1;
z_step 15;
z_end 30;

r_sqr	#calc	"$r*0.424264";
i_sqr	#calc	"$r_sqr*0.707107";

r_minor	#calc	"$r*0.848528";
i_minor	#calc	"$r_minor*0.707107";

i_r	#calc	"$r*0.707107";

i_R	#calc	"$R*0.707107";

// Versiones negadas, calculadas una sola vez (reemplazan a "#neg $var")
n_i_sqr    #calc "-1.0*$i_sqr";
n_i_minor  #calc "-1.0*$i_minor";
n_i_r      #calc "-1.0*$i_r";
n_i_R      #calc "-1.0*$i_R";
n_r_minor  #calc "-1.0*$r_minor";
n_r        #calc "-1.0*$r";
n_R        #calc "-1.0*$R";

vertices
(
    //Inlet
    (0 0 0) //0
    ($i_sqr $i_sqr 0)
    ($n_i_sqr $i_sqr 0)
    ($n_i_sqr $n_i_sqr 0)
    ($i_sqr $n_i_sqr 0)
    ($i_minor $i_minor 0) //5
    ($n_i_minor $i_minor 0)
