FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}

// Gradientes
gradSchemes
{
    default         Gauss linear;
}

// Divergencias (OBLIGATORIO aunque no lo uses)
divSchemes
{
    default         none;
}

// Laplacianos (clave para tu malla por Laplace)
laplacianSchemes
{
    default         Gauss linear corrected;
}

// Interpolaciones
interpolationSchemes
{
    default         linear;
}

// Correcciones de normales
snGradSchemes
{
    default         corrected;
}



