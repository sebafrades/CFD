FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

6
(
    inlet
    {
        type            patch;
        nFaces          25;
        startFace       1200;
    }
    outlet
    {
        type            patch;
        nFaces          25;
        startFace       1225;
    }
    upperWall
    {
        type            wall;
        inGroups        1(wall);
        nFaces          25;
        startFace       1250;
    }
    lowerWall
    {
        type            wall;
        inGroups        1(wall);
        nFaces          25;
        startFace       1275;
    }
    front
    {
        type            empty;
        inGroups        1(empty);
        nFaces          625;
        startFace       1300;
    }
    back
    {
        type            empty;
        inGroups        1(empty);
        nFaces          625;
        startFace       1925;
    }
)

