FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    location    "0";
    object      pointDisplacement;
}

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{

    outlet
    {
        type codedFixedValue;
        value uniform (0 0 0);
        name motionCodeOutlet;

        code
        #{
            //acceder al tiempo de simulación
            const Time& time = this->db().time();
            scalar t = time.value();

            const scalar pi = constant::mathematical::pi;

            //parámetros geométricos
            const scalar R = 0.1161; 
            const scalar r = 0.0441;
            const scalar gamma0 = degToRad(80.0); 
            
            //velocidad angular de rotación para que en 2 segundos pase de 80 a 100 grados
            const scalar omega  = pi / 18.0; 
            scalar gamma = gamma0 + omega * t;

            //centro de rotación de outlet según gamma actual y gamma = 80
            scalar xc = R * cos(gamma);
            scalar yc = R * sin(gamma);

            scalar xc0 = R * cos(gamma0);
            scalar yc0 = R * sin(gamma0);

            const scalar R_int = sqrt(R*R - r*r);

            const scalar beta = atan2(R_int, r); // in radians

            //accesso a puntos del patch outlet
            const vectorField& pts = patch().localPoints(); 
            vectorField& disp = *this;

            //para guardar los puntos del patch outlet en gamma = 80
            static pointField storedPoints0;
            static bool initialized = false;

            if (!initialized)
            {
                storedPoints0 = patch().localPoints();
                initialized = true;
            }

            forAll(disp, i)
            {

                point p0 = storedPoints0[i];

                // obtenemos el theta del punto del patch sobre el que estamos trabajando, o sea, el theta de dicho punto cuando gamma = 80
                scalar theta0 = atan2(p0.y() - yc0, p0.x() - xc0);

                scalar s = (theta0 - (beta + gamma0)) / (pi - (beta + gamma0));

                // nuevo theta para el gamma actual
                scalar thetaNew = (beta + gamma) + s * (pi - (beta + gamma));

                // nuevos valores de x e y para el punto del patch sobre el que estamos trabajando, con el nuevo theta
                scalar xNew = xc + r * cos(thetaNew);
                scalar yNew = yc + r * sin(thetaNew);

                disp[i] = vector(xNew - p0.x(), yNew - p0.y(), 0);
            }
        #};
    }

    lowerWall
    {
        type codedFixedValue;
        value uniform (0 0 0);
        name motionCodeLowerWall;

        code
        #{
            const Time& time = this->db().time();
            scalar t = time.value();
            const scalar pi = constant::mathematical::pi;

            const scalar R = 0.1161; 
            const scalar r = 0.0441;
            const scalar gamma0 = degToRad(80.0);

            const scalar R_int = sqrt(R*R - r*r);

            const scalar omega  = pi / 18.0;  
            scalar gamma = gamma0 + omega * t;

            scalar xc = R * cos(gamma);
            scalar yc = R * sin(gamma) - R_int;

            scalar xc0 = R * cos(gamma0);
            scalar yc0 = R * sin(gamma0) - R_int;

            const vectorField& pts = patch().localPoints();
            vectorField& disp = *this;
            
            static pointField storedPoints0;
            static bool initialized = false;

            if (!initialized)
            {
                storedPoints0 = patch().localPoints();
                initialized = true;
            }

            forAll(disp, i)
            {
                point p0 = storedPoints0[i];
                scalar R_cos = p0.x() - xc0;
                scalar R_sin = p0.y() - yc0;
                
                scalar xNew = xc + R_cos;
                scalar yNew = yc + R_sin;

                disp[i] = vector(xNew - p0.x(), yNew - p0.y(), 0);
            }
        #};
    }

    inlet
    {
        type codedFixedValue;
        value uniform (0 0 0);
        name motionCodeInlet;

        code
        #{
            const Time& time = this->db().time();
            scalar t = time.value();
            const scalar pi = constant::mathematical::pi;

            const scalar R = 0.1161; 
            const scalar r = 0.0441;
            const scalar gamma0 = degToRad(80.0);
            const scalar R_int = sqrt(R*R - r*r);
            const scalar beta = atan2(R_int, r);  // in radians

            const scalar omega = pi / 18.0;
            scalar gamma = gamma0 + omega * t;

            scalar xc  = R * cos(gamma);
            scalar yc  = R * sin(gamma);
            scalar xc0 = R * cos(gamma0);
            scalar yc0 = R * sin(gamma0);

            vectorField& disp = *this;

            static pointField storedPoints0;
            static bool initialized = false;
            if (!initialized)
            {
                storedPoints0 = patch().localPoints();
                initialized = true;
            }

            forAll(disp, i)
            {
                point p0 = storedPoints0[i];

                scalar theta0 = atan2(p0.y() - yc0, p0.x() - xc0);
                
                scalar s = theta0 / (gamma0 - beta);

                scalar thetaNew = s * (gamma - beta);

                scalar xNew = xc + r * cos(thetaNew);
                scalar yNew = yc + r * sin(thetaNew);

                disp[i] = vector(xNew - p0.x(), yNew - p0.y(), 0);
            }
        #};
    }


    upperWall
    {
        type codedFixedValue;
        value uniform (0 0 0);
        name motionCodeUpperWall;

        code
        #{
            const Time& time = this->db().time();
            scalar t = time.value();
            const scalar pi = constant::mathematical::pi;

            const scalar R = 0.1161; 
            const scalar r = 0.0441;
            const scalar gamma0 = degToRad(80.0);

            const scalar omega  = pi / 18.0; 
            scalar gamma = gamma0 + omega * t;

            scalar R_ext = sqrt(R*R + 3*r*r);

            const vectorField& pts = patch().localPoints();
            vectorField& disp = *this;

            static pointField storedPoints0;
            static bool initialized = false;

            if (!initialized)
            {
                storedPoints0 = patch().localPoints();
                initialized = true;
            }

            forAll(disp, i)
            {
                point p0 = storedPoints0[i];
                scalar theta0 = atan2(p0.y(), p0.x());

                scalar xNew  = R_ext * cos(theta0 + (gamma - gamma0));
                scalar yNew  = R_ext * sin(theta0 + (gamma - gamma0));

                disp[i] = vector(xNew - p0.x(), yNew - p0.y(), 0);
            }
        #};
    }
    
}
